# =============================================================================
# Gestor de citas - variables de entorno del BACKEND
#
#  - Desarrollo: copia este fichero a `.env` en la raíz (está en .gitignore).
#  - Producción: se guardan en /etc/gestor-citas/gestor-citas.env (permisos 600),
#    cargado por systemd. NUNCA se suben a Git.
#  - Este fichero no contiene secretos reales.
# =============================================================================

NODE_ENV=development

# --- Servidor ---------------------------------------------------------------
PORT=3000
# Interfaz de escucha. En producción detrás de Caddy se queda en 127.0.0.1.
HOST=127.0.0.1
# URL pública de la app. En producción DEBE empezar por https:// (la app no arranca si no).
APP_URL=http://localhost:5173
# true solo si hay un proxy inverso propio delante (Caddy/Nginx): usa X-Forwarded-For para los límites por IP.
TRUST_PROXY=false

# --- Base de datos (MySQL 8 / MariaDB 10.4+) -----------------------------------
# Desarrollo local con XAMPP: crea la base y el usuario (ver README) y ajusta la contraseña.
DATABASE_URL=mysql://gestor:CAMBIA_ESTA_CLAVE@127.0.0.1:3306/gestor_citas
# Base de datos SEPARADA para las pruebas (su nombre debe acabar en _test; se vacía en cada prueba).
TEST_DATABASE_URL=mysql://gestor:CAMBIA_ESTA_CLAVE@127.0.0.1:3306/gestor_citas_test
# TLS con verificación de certificado (obligatorio con MySQL gestionado de DigitalOcean).
DATABASE_SSL=false
# Certificado CA del servidor (opcional con DATABASE_SSL=true).
# DATABASE_SSL_CA=/etc/gestor-citas/ca-certificate.crt
DATABASE_POOL_SIZE=10
# Migraciones al arrancar: por defecto true en desarrollo y false en producción
# (en producción se aplican con `npm run migrate` durante el despliegue).
# AUTO_MIGRATE=false

# --- Sesiones y seguridad ----------------------------------------------------
SESSION_TTL_HOURS=12
# Por defecto la cookie es Secure en producción. No poner false en producción (la app lo rechaza).
# COOKIE_SECURE=true

# --- Registro de errores y operaciones ---------------------------------------
# Además de stdout (journald), se escribe en este fichero JSON-lines.
LOG_FILE=./data/app.log

# --- Recordatorios (worker) --------------------------------------------------
# true: el proceso de la API ejecuta también el worker (cómodo en desarrollo).
# En producción: REMINDER_WORKER=false en la API y un servicio aparte (`npm run worker`).
REMINDER_WORKER=true
REMINDER_POLL_SECONDS=20

# --- WhatsApp ----------------------------------------------------------------
# test  = MODO DE PRUEBA: no se envía nada real (solo se registra). Es el valor por defecto.
# meta  = WhatsApp Business Cloud API oficial (Meta). Requiere las 3 variables siguientes.
WHATSAPP_PROVIDER=test
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=recordatorio_cita
WHATSAPP_TEMPLATE_LANG=es
WHATSAPP_API_VERSION=v21.0
# WHATSAPP_API_BASE=https://graph.facebook.com

# --- Datos de demostración (solo `npm run seed`; no usar en producción) ---------
# Si no defines SEED_ADMIN_PASSWORD (mín. 10 caracteres), el seed genera una contraseña aleatoria y la muestra una sola vez.
SEED_ADMIN_EMAIL=admin@demo.local
# SEED_ADMIN_PASSWORD=

# --- Copias de seguridad (`npm run backup`) ----------------------------------
# Copias con mysqldump (requiere el cliente de MySQL; en XAMPP: MYSQLDUMP_BIN=C:/xampp/mysql/bin/mysqldump.exe).
# BACKUP_DIR=./backups
# BACKUP_KEEP=14
